      "id": "S1",
      "name": "Demand surge +20%",
      "levers": {
        "demand_growth_pct": 0.2
      },
      "rationale": "Outbreak, flood response or a new campaign in the service area."
    },
    {
      "id": "S2",
      "name": "Price shock +15%",
      "levers": {
        "price_inflation_pct": 0.09,
        "price_shock_pct": 0.15
      },
      "rationale": "Currency depreciation, loss of a contract price or a supplier exit."
    },
    {
      "id": "S3",
      "name": "Supply disruption (lead time x1.6, reliability 70%)",
      "levers": {
        "lead_time_multiplier": 1.6,
        "supplier_reliability_pct": 0.7
      },
      "rationale": "Import delay, port congestion or a single-source supplier failing."
    },

      "id": "S4",
      "name": "Funding cut -20%",
      "levers": {
        "funding_cut_pct": 0.2
      },
      "rationale": "Donor reduction or a hold on a grant instalment."
    },
    {
      "id": "S5",
      "name": "Optimised policy (cover 60, safety 10, redistribute 60%)",
      "levers": {
        "target_cover_days": 60,
        "safety_stock_days": 10,
        "redistribution_share_pct": 0.6,
        "lead_time_multiplier": 1.0,
        "excess_stock_release_pct": 0.9
      },
      "rationale": "Tighter cover policy plus redistribution instead of new buying."
    },
    {
      "id": "S6",
      "name": "Framework contracting (-8% price, lead time x0.8)",
      "levers": {
        "bulk_discount_pct": 0.08,
        "lead_time_multiplier": 0.8,
        "supplier_reliability_pct": 0.95
      },
      "rationale": "Consolidate the top items into a framework agreement."
    },
    {
      "id": "S7",
      "name": "Combined downside (demand +15%, price +10%, lead time x1.4, funding -10%)",
      "levers": {
        "demand_growth_pct": 0.15,
        "price_shock_pct": 0.1,
        "lead_time_multiplier": 1.4,
        "supplier_reliability_pct": 0.75,
        "funding_cut_pct": 0.1
      },
      "rationale": "The plausible worst case: surge demand plus inflation plus supply delay plus a funding hold."
    },
    {
      "id": "S8",
      "name": "Optimised response to the downside (S7 + policy and framework levers)",
      "levers": {
        "demand_growth_pct": 0.15,
        "price_shock_pct": 0.1,
        "lead_time_multiplier": 1.2,
        "supplier_reliability_pct": 0.85,
        "funding_cut_pct": 0.1,
        "target_cover_days": 60,
        "safety_stock_days": 10,
        "redistribution_share_pct": 0.6,
        "bulk_discount_pct": 0.08
      },
      "rationale": "Shows how much of the downside can be absorbed by levers available to management."
    }
